{
  "name": "model-router",
  "version": "1.0.0",
  "private": true,
  "description": "Jev-sized model routing for Pi: pick the smallest model that can do the job, then hand the message to it.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "model-router": "./bin/router.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/model-router.ts"
    ]
  },
  "scripts": {
    "router": "node ./bin/router.mjs",
    "status": "node ./bin/router.mjs status",
    "test": "node --test test/*.test.mjs",
    "test:samples": "node ./bin/router.mjs test-samples",
    "test:canary": "node ./test/switch-canary.mjs"
  },
  "license": "MIT"
}
